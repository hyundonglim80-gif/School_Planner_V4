rules_version = '2';

// ┌──────────────────────────────────────────────────────────────────────┐
// │ 2026-09-15: 콘솔의 실제 운영 규칙을 받아 이 파일을 거기에 맞췄습니다. │
// │                                                                      │
// │ 아래 "1단계"는 지금 콘솔에 있는 규칙을 그대로 두고 빠져 있던 것과     │
// │ 새로 필요한 것만 더한 것입니다. 기존 동작을 바꾸지 않습니다.          │
// │                                                                      │
// │ groups 권한을 조이는 일은 "2단계"로 파일 맨 아래에 주석으로 남겨      │
// │ 두었습니다. 지금 같이 배포하면 그룹 참여가 깨질 수 있습니다.          │
// │ 이유는 그쪽에 적어 두었습니다.                                        │
// │                                                                      │
// │   Firebase 콘솔 → Firestore Database → 규칙                          │
// │   배포 전 "규칙 플레이그라운드"로 시험해 보세요.                      │
// │                                                                      │
// │ V3와 V4가 같은 프로젝트(schoolplannerv3)를 쓰므로 두 앱의 접근        │
// │ 경로를 모두 만족해야 합니다.                                          │
// └──────────────────────────────────────────────────────────────────────┘

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 등록된 개발자 계정. src/lib/developers.ts 와 같은 목록을 유지해야 한다.
    function isDeveloper() {
      return signedIn() && request.auth.token.email in [
        'hyundonglim@gmail.com',
        'hyundonglim80@gmail.com',
        'hyundonglim.work@gmail.com'
      ];
    }

    // ── 개인 데이터 ────────────────────────────────────────────────────
    // events / schedules / journals / tasks / settings / trash 전부 포함
    // (콘솔의 현재 규칙과 같다)
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ── 초대 코드 → 그룹 ID 매핑 ───────────────────────────────────────
    // ⚠️ 현재 콘솔 규칙에는 이 컬렉션이 아예 없어서 기본 거부 상태다.
    //    그런데 V3와 V4 둘 다 inviteCodes/{코드} 문서를 읽고 쓴다.
    //      참여: getDoc(inviteCodes/{코드})  -> 지금은 권한 거부로 실패한다
    //      생성: setDoc(inviteCodes/{코드})  -> 지금은 매핑이 만들어지지 않는다
    //    그래서 지금은 초대 코드로 그룹에 참여할 수 없다.
    //
    // 코드를 아는 사람만 단건 조회(get)할 수 있고, 목록 조회(list)는 막아
    // 코드 전체를 훑을 수 없게 한다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      // update가 없으면 이미 있는 매핑을 다시 쓸 때 거부된다. 그룹을 만드는 순간
      // 두 곳에서 같은 문서를 쓰려 해 늦은 쪽이 막히는 일이 실제로 있었다.
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── 공휴일 (모두가 같이 보는 자료) ─────────────────────────────────
    // 개발자가 1년에 한 번 공공데이터포털에서 받아 여기에 적어둔다.
    // 사용자는 읽기만 하므로 API 키를 발급받을 필요도, 가질 필요도 없다.
    match /holidays/{year} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    // ── 개발자 전용 설정 ───────────────────────────────────────────────
    // 공공데이터 API 키가 들어 있다. 소스에 두면 빌드 결과물에 실려
    // 누구나 꺼내 쓸 수 있으므로, 읽기까지 개발자로 제한한다.
    match /admin/{document=**} {
      allow read, write: if isDeveloper();
    }

    // ── 공유 그룹 ──────────────────────────────────────────────────────
    // 예전에는 여기가 `if signedIn()` 하나였다. 구글 계정만 있으면 누구나
    // 모든 그룹을 목록으로 훑고, 초대 코드를 읽고, 남의 그룹 상담 기록을
    // 읽고 고치고 그룹을 통째로 지울 수 있었다. 에뮬레이터에서 실제로 되는 것을
    // 확인했다. 개인 공간(users/{uid})은 원래부터 막혀 있었고 여기만 열려 있었다.
    //
    // 이제 '그 그룹의 구성원인가'를 묻는다.
    match /groups/{groupId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerId;
      }

      // 구성원만 읽는다. 목록 조회(list)는 두 앱 모두
      //   where('members', 'array-contains', 내 uid)
      // 로만 하므로 이 규칙을 통과한다.
      allow get, list: if isMember();

      // 만들 때는 자기가 그룹장이고 자기가 구성원이어야 한다.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // 그룹장은 무엇이든 고친다.
      // 그 외에는 '자기 자신만' 구성원으로 넣거나 빼는 것(참여/탈퇴)만 허용한다.
      //
      // ⚠️ 참여하는 사람은 아직 구성원이 아니라 이 문서를 읽지 못한다. 그래도
      //    규칙 안에서는 resource.data를 볼 수 있으므로 검사에는 지장이 없다.
      //    단, 앱이 '참여 전에 그룹 문서를 읽을 수 있다'고 가정하면 안 된다.
      //
      // ⚠️ V3가 예전에 쓰던 setDoc({'memberDetails.<uid>': ...}) 는 점이 든
      //    이름의 필드를 통째로 만들어서 affectedKeys가 'memberDetails'가 아니게
      //    된다. 그래서 두 앱 모두 updateDoc으로 고쳤다. 이 규칙보다 앱 배포가
      //    먼저 나가야 한다.
      allow update: if isOwner() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'memberDetails'])
        && (
          request.resource.data.members == resource.data.members.concat([request.auth.uid])
          || request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        )
      );

      // 그룹장만 지운다. (하위 컬렉션은 앱이 먼저 비운다. Firestore는 문서를
      // 지워도 하위 컬렉션을 지우지 않아서, 순서를 바꾸면 손댈 수 없는 자료가 남는다)
      allow delete: if isOwner();

    }

    // 그룹 안의 일정/수업/기록/메모/조사표
    //
    // ⚠️ 위 match 안에 `match /{document=**}` 로 넣으면 안 된다. 재귀 와일드카드는
    //    빈 경로도 받아서 '그룹 문서 자신'까지 걸린다. 그러면 여기의 read/write가
    //    위의 get/update/delete 규칙을 덮어써서, 구성원이면 누구나 그룹 이름을
    //    바꾸고 그룹을 통째로 지울 수 있게 된다. 실제로 그래서 점검에서
    //    '구성원 B가 그룹을 지웠다'가 나왔다.
    //    하위 컬렉션 이름 자리를 하나 두어 그룹 문서에는 걸리지 않게 한다.
    match /groups/{groupId}/{sub}/{document=**} {
      allow read, write: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

  }
}

// ──────────────────────────────────────────────────────────────────────
// 배포 순서 (지키지 않으면 V3에서 그룹 참여가 깨진다)
//
//   1. 앱 먼저 — V3/V4의 참여 코드를 updateDoc으로 고친 것을 배포한다.
//      (setDoc은 'memberDetails.<uid>'를 점이 든 이름의 필드로 만들어,
//       위 update 규칙의 hasOnly를 통과하지 못한다)
//   2. 그룹장들이 앱을 한 번 열어 '초대 코드 -> 그룹' 매핑이 채워지기를 기다린다.
//      환경설정 > 개발자 설정 > 공유 그룹 점검 에서 남은 것을 확인할 수 있다.
//      (매핑이 없는 그룹은 '그룹 목록을 훑는' 폴백에 기대는데, 위 규칙이 그걸 막는다)
//   3. 목록이 비면 이 규칙을 배포한다.
// ──────────────────────────────────────────────────────────────────────
