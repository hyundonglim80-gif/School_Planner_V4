rules_version = '2';

// ┌──────────────────────────────────────────────────────────────────────┐
// │ 2026-09-15: 콘솔의 실제 운영 규칙을 받아 이 파일을 거기에 맞췄습니다. │
// │                                                                      │
// │ 아래 "1단계"는 지금 콘솔에 있는 규칙을 그대로 두고 빠져 있던 것과     │
// │ 새로 필요한 것만 더한 것입니다. 기존 동작을 바꾸지 않습니다.          │
// │                                                                      │
// │ groups 권한을 조이는 일은 "2단계"로 파일 맨 아래에 주석으로 남겨      │
// │ 두었습니다. 지금 같이 배포하면 그룹 참여가 깨질 수 있습니다.          │
// │ 이유는 그쪽에 적어 두었습니다.                                        │
// │                                                                      │
// │   Firebase 콘솔 → Firestore Database → 규칙                          │
// │   배포 전 "규칙 플레이그라운드"로 시험해 보세요.                      │
// │                                                                      │
// │ V3와 V4가 같은 프로젝트(schoolplannerv3)를 쓰므로 두 앱의 접근        │
// │ 경로를 모두 만족해야 합니다.                                          │
// └──────────────────────────────────────────────────────────────────────┘

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 등록된 개발자 계정. src/lib/developers.ts 와 같은 목록을 유지해야 한다.
    function isDeveloper() {
      return signedIn() && request.auth.token.email in [
        'hyundonglim@gmail.com',
        'hyundonglim80@gmail.com',
        'hyundonglim.work@gmail.com'
      ];
    }

    // ── 개인 데이터 ────────────────────────────────────────────────────
    // events / schedules / journals / tasks / settings / trash 전부 포함
    // (콘솔의 현재 규칙과 같다)
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // ── 초대 코드 → 그룹 ID 매핑 ───────────────────────────────────────
    // ⚠️ 현재 콘솔 규칙에는 이 컬렉션이 아예 없어서 기본 거부 상태다.
    //    그런데 V3와 V4 둘 다 inviteCodes/{코드} 문서를 읽고 쓴다.
    //      참여: getDoc(inviteCodes/{코드})  -> 지금은 권한 거부로 실패한다
    //      생성: setDoc(inviteCodes/{코드})  -> 지금은 매핑이 만들어지지 않는다
    //    그래서 지금은 초대 코드로 그룹에 참여할 수 없다.
    //
    // 코드를 아는 사람만 단건 조회(get)할 수 있고, 목록 조회(list)는 막아
    // 코드 전체를 훑을 수 없게 한다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── 공휴일 (모두가 같이 보는 자료) ─────────────────────────────────
    // 개발자가 1년에 한 번 공공데이터포털에서 받아 여기에 적어둔다.
    // 사용자는 읽기만 하므로 API 키를 발급받을 필요도, 가질 필요도 없다.
    match /holidays/{year} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    // ── 개발자 전용 설정 ───────────────────────────────────────────────
    // 공공데이터 API 키가 들어 있다. 소스에 두면 빌드 결과물에 실려
    // 누구나 꺼내 쓸 수 있으므로, 읽기까지 개발자로 제한한다.
    match /admin/{document=**} {
      allow read, write: if isDeveloper();
    }

    // ── 공유 그룹 ──────────────────────────────────────────────────────
    // 콘솔의 현재 규칙을 그대로 둔다. 조이는 것은 아래 "2단계" 참고.
    match /groups/{groupId} {
      allow read, write: if signedIn();

      // 그룹 하위의 일정/수업/기록/메모
      match /{document=**} {
        allow read, write: if signedIn();
      }
    }

  }
}

// ──────────────────────────────────────────────────────────────────────
// 2단계 (나중에, 따로 배포할 것)
//
// 지금 groups 규칙은 "로그인한 사람이면 누구나 아무 그룹이나 읽고 쓰고
// 지울 수 있다"는 뜻이다. 남의 그룹 일정을 지우거나, 그룹 목록을 훑어
// 초대 코드를 전부 긁어모으는 것도 막지 않는다.
//
// 아래처럼 조이면 그게 막히지만, 먼저 확인해야 할 것이 있다.
//
//   (1) list를 "내가 속한 그룹"으로 제한하면,
//       inviteCodes 매핑이 없는 옛날 그룹의 폴백 경로
//         query(groups, where('inviteCode','==',코드))
//       가 막힌다. 참여하려는 사람은 아직 members가 아니기 때문이다.
//       -> 1단계를 배포해 두면 그룹장이 앱을 한 번 열 때 매핑이 채워진다
//          (useGroups.ts의 ensureInviteCodeDoc). 모든 그룹에 매핑이
//          생긴 뒤에 2단계를 배포해야 한다.
//
//   (2) V3의 참여 코드가 이렇게 쓴다.
//         setDoc(groups/{id}, { members: arrayUnion(uid),
//                               ['memberDetails.' + uid]: {...} }, {merge:true})
//       setDoc은 updateDoc과 달리 점이 든 키를 "하위 필드 경로"로 보지
//       않고 그냥 그 이름의 필드로 만든다. 즉 실제로 바뀌는 키 이름이
//       memberDetails 가 아니라 "memberDetails.<uid>" 일 수 있다.
//       그러면 아래 hasOnly(['members','memberDetails'])를 통과하지 못해
//       V3에서 그룹 참여가 막힌다.
//       -> 콘솔에서 실제 그룹 문서의 필드 이름을 먼저 확인하고,
//          필요하면 V3 코드를 updateDoc으로 고친 뒤에 배포할 것.
//
// match /groups/{groupId} {
//   allow get: if signedIn();
//   allow list: if signedIn() && request.auth.uid in resource.data.members;
//
//   allow create: if signedIn()
//     && request.resource.data.ownerId == request.auth.uid
//     && request.resource.data.members == [request.auth.uid];
//
//   // 그룹장은 무엇이든 수정 가능.
//   // 그 외에는 "자기 자신만" members에 넣거나 빼는 것(참여/탈퇴)만 허용.
//   allow update: if signedIn() && (
//     resource.data.ownerId == request.auth.uid
//     || (
//       request.resource.data.diff(resource.data).affectedKeys()
//         .hasOnly(['members', 'memberDetails'])
//       && (
//         request.resource.data.members == resource.data.members.concat([request.auth.uid])
//         || request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
//       )
//     )
//   );
//
//   allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
// }
//
// match /groups/{groupId}/{document=**} {
//   allow read, write: if signedIn()
//     && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
// }
// ──────────────────────────────────────────────────────────────────────
