rules_version = '2';

// ┌──────────────────────────────────────────────────────────────────────┐
// │ ⚠️ 이 파일은 "검토용 제안"입니다. 아직 배포되지 않았습니다.            │
// │                                                                      │
// │ 현재 운영 중인 규칙은 Firebase 콘솔에만 있습니다. 먼저 콘솔의         │
// │ 현재 규칙과 아래 내용을 비교해 보시고, 맞다면 배포하세요.             │
// │                                                                      │
// │   Firebase 콘솔 → Firestore Database → 규칙                          │
// │   또는  firebase deploy --only firestore:rules                       │
// │                                                                      │
// │ 배포 전 반드시 콘솔의 "규칙 플레이그라운드"로 시험해 보세요.          │
// │ 잘못 배포하면 앱 전체가 권한 거부로 멈춥니다.                         │
// │                                                                      │
// │ V3와 V4가 같은 프로젝트(schoolplannerv3)를 공유하므로, 두 앱의        │
// │ 접근 경로를 모두 만족해야 합니다.                                     │
// └──────────────────────────────────────────────────────────────────────┘

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 등록된 개발자 계정. src/lib/developers.ts 와 같은 목록을 유지해야 한다.
    function isDeveloper() {
      return signedIn() && request.auth.token.email in [
        'hyundonglim@gmail.com',
        'hyundonglim80@gmail.com',
        'hyundonglim.work@gmail.com'
      ];
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // ── 개인 데이터 ────────────────────────────────────────────────────
    // events / schedules / journals / tasks / settings / trash 전부 포함
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── 공휴일 (모두가 같이 보는 자료) ─────────────────────────────────
    // 개발자가 1년에 한 번 공공데이터포털에서 받아 여기에 적어둔다.
    // 사용자는 읽기만 하므로 API 키를 발급받을 필요도, 가질 필요도 없다.
    // 이 규칙이 배포되지 않으면 '내려받아 저장'이 권한 오류로 실패한다.
    match /holidays/{year} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    // ── 개발자 전용 설정 ───────────────────────────────────────────────
    // 공공데이터 API 키가 여기 들어 있다. 소스에 두면 빌드 결과물에 실려
    // 누구나 꺼내 쓸 수 있으므로, 읽기까지 개발자로 제한한다.
    match /admin/{document=**} {
      allow read, write: if isDeveloper();
    }

    // ── 공유 그룹 ──────────────────────────────────────────────────────
    // 초대 코드 -> 그룹 ID 매핑. 코드를 아는 사람만 단건 조회할 수 있고,
    // 목록 조회를 막아 코드 전체를 훑을 수 없게 한다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /groups/{groupId} {
      // 단건 조회(get)는 허용하되 목록 조회(list)는 내가 속한 그룹으로 제한한다.
      // 이러면 members 조건이 붙은 내 그룹 목록 쿼리는 통과하고,
      // inviteCode로 전체를 훑는 쿼리는 막힌다.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // 그룹장은 무엇이든 수정 가능.
      // 그 외에는 "자기 자신만" members에 넣거나 빼는 것(참여/탈퇴)만 허용한다.
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          // V3는 참여할 때 members와 함께 memberDetails.{uid}도 기록한다
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberDetails'])
          && (
            request.resource.data.members == resource.data.members.concat([request.auth.uid])
            || request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          )
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 그룹의 일정/수업/기록/메모는 그룹 구성원만 접근
    match /groups/{groupId}/{document=**} {
      allow read, write: if isMember(groupId);
    }
  }
}
